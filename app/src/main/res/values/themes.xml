<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- TV 端：Leanback 主题（大屏 + 遥控器焦点） -->
    <style name="Theme.LiveTv" parent="Theme.Leanback">
        <item name="defaultBrandColor">@color/brand_primary</item>
        <item name="defaultSearchColor">@color/search_highlight</item>
    </style>

    <!-- 手机/平板端：普通 AppCompat 暗色主题（触控交互，不使用 Leanback 焦点体系） -->
    <style name="Theme.LiveTv.Mobile" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/mobile_background</item>
        <item name="android:colorBackground">@color/mobile_background</item>
        <!-- 状态栏透明：真正的隐藏/临时呼出由代码里的 WindowInsetsControllerCompat 控制，
             这里只保证"呼出瞬间"背景不出现第二种颜色 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/mobile_background</item>
        <item name="android:textColorPrimary">@color/mobile_text_primary</item>
        <item name="colorAccent">@color/mobile_accent</item>
        <item name="colorPrimary">@color/mobile_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- 挖孔屏：让内容延伸到短边（横屏时即左右两侧），由代码再按 displayCutout 补安全区 -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!-- 单行顶栏里的紧凑文字按钮：无边框、低视觉权重 -->
    <style name="WidgetLiveTvHeaderAction">
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textColor">@color/mobile_text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- 播放页：全屏无 ActionBar，支持刘海/挖孔屏短边延伸 -->
    <style name="Theme.LiveTv.Player" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="colorAccent">@color/mobile_accent</item>
    </style>
</resources>
