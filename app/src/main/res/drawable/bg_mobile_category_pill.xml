<?xml version="1.0" encoding="utf-8"?>
<!--
  分类胶囊（暗黑影院风）：选中 = 半透明高亮底 #2EFFFFFF + 1dp 柔和描边 #59FFFFFF；
  未选中 = 极淡暗底 #12FFFFFF、无重边框。
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetTop="3dp"
    android:insetBottom="3dp">
    <ripple android:color="#26FFFFFF">
        <item>
            <selector>
                <item android:state_focused="true" android:state_selected="true">
                    <shape android:shape="rectangle">
                        <solid android:color="@color/mobile_home_capsule_selected" />
                        <corners android:radius="18dp" />
                        <stroke
                            android:width="2dp"
                            android:color="@color/mobile_home_text_primary" />
                    </shape>
                </item>
                <item android:state_selected="true">
                    <shape android:shape="rectangle">
                        <solid android:color="@color/mobile_home_capsule_selected" />
                        <corners android:radius="18dp" />
                        <stroke
                            android:width="1dp"
                            android:color="@color/mobile_home_capsule_selected_stroke" />
                    </shape>
                </item>
                <item android:state_focused="true">
                    <shape android:shape="rectangle">
                        <solid android:color="@color/mobile_home_capsule_normal" />
                        <corners android:radius="18dp" />
                        <stroke
                            android:width="2dp"
                            android:color="@color/mobile_home_capsule_selected_stroke" />
                    </shape>
                </item>
                <item>
                    <shape android:shape="rectangle">
                        <solid android:color="@color/mobile_home_capsule_normal" />
                        <corners android:radius="18dp" />
                    </shape>
                </item>
            </selector>
        </item>
    </ripple>
</inset>
