<?xml version="1.0" encoding="utf-8"?>
<!--
  Android TV 桌面横幅（320dp × 180dp）中的电视 + 播放矢量主体。
  纯矢量绘制，零位图资源；白色线条在黑蓝渐变底板上保持足够对比度。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 屏幕外框：半透明玻璃底 + 白色圆角描边 -->
    <path
        android:fillColor="#26FFFFFF"
        android:pathData="M28,26 H80 a8,8 0 0 1 8,8 V66 a8,8 0 0 1 -8,8 H28 a8,8 0 0 1 -8,-8 V34 a8,8 0 0 1 8,-8 Z"
        android:strokeColor="#FFFFFF"
        android:strokeLineJoin="round"
        android:strokeWidth="5" />

    <!-- 播放三角 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M48,38 L48,62 L68,50 Z" />

    <!-- 支架与底座 -->
    <path
        android:pathData="M54,74 V82"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="5" />
    <path
        android:pathData="M40,86 H68"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="5" />
</vector>
