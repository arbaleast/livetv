<?xml version="1.0" encoding="utf-8"?>
<!--
  手机/平板主界面（横屏优先）：左侧分类导航栏 + 右侧"单行顶栏 + 自适应频道网格"。

  顶栏是**浮层**，叠在网格之上：网格用 paddingTop 预留同样的高度并开启 clipToPadding=false，
  这样列表滚动时卡片会滑到顶栏下方，顶栏收起后那块空间立刻露出内容，不会出现黑色空白占位。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mobile_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mobile_background"
    android:orientation="horizontal">

    <!-- 左侧分类导航栏 -->
    <LinearLayout
        android:id="@+id/layout_category_rail"
        android:layout_width="118dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="10dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_categories"
            android:layout_width="match_parent"
            android:nextFocusRight="@id/rv_channels"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingTop="2dp"
            android:paddingBottom="10dp"
            android:scrollbars="none" />
    </LinearLayout>

    <View
        android:id="@+id/category_divider"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/mobile_card_stroke" />

    <!-- 右侧主内容区 -->
    <FrameLayout
        android:id="@+id/layout_content"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_channels"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="18dp"
            android:scrollbars="none" />

        <!-- 顶栏遮罩：让卡片在顶栏下缘自然淡出，而不是被生硬切断 -->
        <View
            android:id="@+id/top_edge_scrim"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_gravity="top"
            android:background="@drawable/bg_mobile_top_scrim"
            android:clickable="false"
            android:focusable="false" />

        <!-- 单行紧凑顶栏 -->
        <LinearLayout
            android:id="@+id/layout_top_header"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_gravity="top"
            android:nextFocusDown="@id/rv_channels"
            android:background="@color/mobile_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/top_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="@color/mobile_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mobile_total_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_mobile_pill_count"
                android:paddingStart="8dp"
                android:paddingTop="1dp"
                android:paddingEnd="8dp"
                android:paddingBottom="1dp"
                android:textColor="@color/mobile_text_tertiary"
                android:textSize="11sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/mobile_refresh"
                style="@style/WidgetLiveTvHeaderAction"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_mobile_action_button"
                android:text="@string/mobile_action_refresh" />

            <TextView
                android:id="@+id/mobile_subscription"
                style="@style/WidgetLiveTvHeaderAction"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_mobile_action_button"
                android:text="@string/mobile_action_subscription" />
            <!-- 预留：轻量搜索入口（本次不新增搜索功能，仅占位保持顶栏结构可扩展） -->
            <TextView
                android:id="@+id/mobile_search"
                style="@style/WidgetLiveTvHeaderAction"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_mobile_action_button"
                android:text="@string/mobile_action_search"
                android:visibility="gone" />

        </LinearLayout>

        <TextView
            android:id="@+id/empty_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="@string/mobile_empty_channels"
            android:textColor="@color/mobile_text_tertiary"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
