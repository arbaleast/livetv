<?xml version="1.0" encoding="utf-8"?>
<!--
  手机竖屏主界面（< 600dp）：顶部单行顶栏（含内联搜索切换） + 横向分类胶囊条 + 满宽自适应频道网格（可用宽度 < 360dp 时单列，否则 2 列起）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mobile_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mobile_background"
    android:orientation="vertical">

    <!-- 顶部容器：常规顶栏与内联搜索栏互斥切换 -->
    <FrameLayout
        android:id="@+id/layout_top_header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:background="@color/mobile_background">

        <LinearLayout
            android:id="@+id/layout_top_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:background="@color/mobile_background"
            android:gravity="center_vertical"
            android:nextFocusDown="@id/rv_categories"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="10dp">

            <!--
              标题区占用剩余宽度（替代原 Space）。大字体下「优先压缩/省略标题」，避免把右侧
              三个操作按钮推出屏幕（review P1-2）；按钮各自 maxWidth + ellipsize 保底不被硬裁切。
              用 RelativeLayout 约束标题宽度（toStartOf 数量角标），避免嵌套 weight 的性能告警。
            -->
            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/mobile_total_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_mobile_pill_count"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:maxWidth="80dp"
                    android:paddingStart="7dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="7dp"
                    android:paddingBottom="1dp"
                    android:textColor="@color/mobile_text_tertiary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/top_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="8dp"
                    android:layout_toStartOf="@id/mobile_total_count"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/app_name"
                    android:textColor="@color/mobile_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <TextView
                android:id="@+id/mobile_search"
                style="@style/WidgetLiveTvHeaderAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="84dp"
                android:minHeight="48dp"
                android:minWidth="48dp"
                android:background="@drawable/bg_mobile_action_button"
                android:text="@string/mobile_action_search" />

            <TextView
                android:id="@+id/mobile_refresh"
                style="@style/WidgetLiveTvHeaderAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="84dp"
                android:minHeight="48dp"
                android:minWidth="48dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_mobile_action_button"
                android:text="@string/mobile_action_refresh" />

            <TextView
                android:id="@+id/mobile_subscription"
                style="@style/WidgetLiveTvHeaderAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="84dp"
                android:minHeight="48dp"
                android:minWidth="48dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_mobile_action_button"
                android:text="@string/mobile_action_subscription" />
        </LinearLayout>

        <!-- 内联实时搜索栏 -->
        <LinearLayout
            android:id="@+id/layout_search_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:background="@color/mobile_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="10dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/edit_search"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:background="@drawable/bg_mobile_action_button"
                android:hint="@string/mobile_search_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/mobile_text_primary"
                android:textColorHint="@color/mobile_text_tertiary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btn_search_clear"
                style="@style/WidgetLiveTvHeaderAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:minWidth="48dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_mobile_action_button"
                android:text="@string/mobile_search_clear"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btn_search_close"
                style="@style/WidgetLiveTvHeaderAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:minWidth="48dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_mobile_action_button"
                android:text="@string/mobile_search_cancel" />
        </LinearLayout>
    </FrameLayout>

    <!-- 顶部横向分类条 -->
    <LinearLayout
        android:id="@+id/layout_category_rail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="8dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_categories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:nextFocusDown="@id/rv_channels"
            android:overScrollMode="never"
            android:paddingStart="12dp"
            android:paddingEnd="4dp"
            android:scrollbars="none" />
    </LinearLayout>

    <View
        android:id="@+id/category_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/mobile_card_stroke" />

    <!-- 主内容区 -->
    <FrameLayout
        android:id="@+id/layout_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_channels"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="18dp"
            android:scrollbars="none" />

        <View
            android:id="@+id/top_edge_scrim"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_gravity="top"
            android:background="@drawable/bg_mobile_top_scrim"
            android:clickable="false"
            android:focusable="false" />

        <LinearLayout
            android:id="@+id/loading_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:indeterminate="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/mobile_loading_channels"
                android:textColor="@color/mobile_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/empty_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/mobile_empty_channels"
            android:textColor="@color/mobile_text_tertiary"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
