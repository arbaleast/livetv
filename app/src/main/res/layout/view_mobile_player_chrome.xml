<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chrome_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 左上角常驻 Stats for Nerds 视频信息面板（可通过底栏「信息」开关，不拦截触控） -->
    <TextView
        android:id="@+id/chrome_video_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="14dp"
        android:layout_marginTop="64dp"
        android:background="@drawable/bg_player_info_panel"
        android:clickable="false"
        android:focusable="false"
        android:fontFamily="monospace"
        android:lineSpacingExtra="2dp"
        android:maxLines="12"
        android:maxWidth="320dp"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp"
        android:textColor="#E6FFFFFF"
        android:textSize="10.5sp"
        android:visibility="gone" />

    <!-- 顶栏：渐变暗角 + 返回 / 频道名 / 静态 LIVE 胶囊 / 收藏 / 原控(CCTV) / 选台 -->
    <LinearLayout
        android:id="@+id/chrome_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_player_top_gradient"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="18dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/chrome_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_player_circle_button"
            android:contentDescription="@string/player_cd_back"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_player_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chrome_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/mobile_text_primary"
                android:textSize="15sp" />

            <!-- 静态 LIVE 徽标（小红点静态圆 + LIVE，零动画） -->
            <LinearLayout
                android:id="@+id/chrome_live_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_player_live_badge"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp">

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_player_live_dot" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.06"
                    android:text="@string/player_live_badge"
                    android:textColor="@android:color/white"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/chrome_web_controls"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_player_pill_button"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:minWidth="56dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/cctv_web_control_native"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/chrome_favorite"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_player_circle_button"
            android:contentDescription="@string/player_cd_favorite"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_player_favorite_outline" />

        <LinearLayout
            android:id="@+id/chrome_channels"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_player_pill_button"
            android:clickable="true"
            android:contentDescription="@string/player_cd_channels"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_player_channels" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/player_touch_channels"
                android:textColor="@android:color/white"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 底栏：渐变暗角 + MGTV(上一台/播放暂停/下一台 + 比例) 或 CCTV(刷新) + 共享横竖屏 -->
    <LinearLayout
        android:id="@+id/chrome_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_player_bottom_gradient"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="18dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/chrome_prev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_player_circle_button"
            android:contentDescription="@string/player_cd_prev"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_player_prev"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/chrome_play_pause"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_player_circle_button"
            android:contentDescription="@string/player_cd_play_pause"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_player_pause"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/chrome_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_player_circle_button"
            android:contentDescription="@string/player_cd_next"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_player_next"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/chrome_reload"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_player_circle_button"
            android:contentDescription="@string/player_cd_refresh"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_player_refresh"
            android:visibility="gone" />

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chrome_info"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_player_pill_button"
                    android:clickable="true"
                    android:contentDescription="@string/player_cd_video_info"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:text="@string/player_video_info_button"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/chrome_enhance"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_player_pill_button"
                    android:clickable="true"
                    android:contentDescription="@string/player_cd_enhance"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_player_enhance" />

                    <TextView
                        android:id="@+id/chrome_enhance_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/player_enhance_off"
                        android:textColor="@android:color/white"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/chrome_aspect"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_player_pill_button"
                    android:clickable="true"
                    android:contentDescription="@string/player_cd_aspect"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_player_aspect" />

                    <TextView
                        android:id="@+id/chrome_aspect_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/player_touch_aspect_fit"
                        android:textColor="@android:color/white"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/chrome_pip"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_player_circle_button"
                    android:contentDescription="@string/player_cd_pip"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_player_pip" />

                <ImageButton
                    android:id="@+id/chrome_rotate"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_player_circle_button"
                    android:contentDescription="@string/player_cd_rotate"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_player_rotate" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- 左侧垂直居中悬浮 44dp 圆形锁屏按钮 -->
    <ImageButton
        android:id="@+id/chrome_lock"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="16dp"
        android:background="@drawable/bg_player_circle_button"
        android:contentDescription="@string/player_cd_lock"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_player_lock"
        android:visibility="gone" />

    <!-- 正中胶囊 HUD（168dp x 44dp：20dp 矢量图标 + 4dp 细进度条 + 等宽百分比，兼容简短提示态） -->
    <FrameLayout
        android:id="@+id/chrome_hud"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_player_hud_pill"
        android:minWidth="168dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/chrome_hud_meter"
            android:layout_width="140dp"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/chrome_hud_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_player_brightness" />

            <ProgressBar
                android:id="@+id/chrome_hud_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="50"
                android:progressDrawable="@drawable/bg_player_hud_progress" />

            <TextView
                android:id="@+id/chrome_hud_percent"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="end"
                android:textColor="@android:color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/chrome_hud_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 统一错误卡片（居中：错误信息 + 高对比度白底黑字「重试」主按钮 + 「选台」次按钮） -->
    <LinearLayout
        android:id="@+id/chrome_error_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_player_hud_pill"
        android:gravity="center_horizontal"
        android:maxWidth="320dp"
        android:minWidth="240dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/chrome_error_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/mobile_text_primary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chrome_error_retry"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_player_error_primary_button"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:minWidth="88dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="@string/player_touch_retry"
                android:textColor="#0B0E14"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chrome_error_channels"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_player_pill_button"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:minWidth="88dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="@string/player_touch_channels"
                android:textColor="@android:color/white"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 右侧选台抽屉：半透明遮罩 + 280dp 面板 + 顶部分组筛选胶囊栏 -->
    <View
        android:id="@+id/chrome_drawer_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/mobile_drawer_scrim"
        android:clickable="true"
        android:contentDescription="@string/player_drawer_scrim_desc"
        android:focusable="false"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/chrome_drawer_panel"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/bg_player_drawer"
        android:visibility="gone">

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="@color/mobile_drawer_edge" />

        <LinearLayout
            android:id="@+id/chrome_drawer_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:text="@string/player_drawer_title"
                android:textColor="@color/mobile_text_tertiary"
                android:textSize="12sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/chrome_drawer_filters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp"
                android:scrollbars="none" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/chrome_drawer_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="18dp"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/chrome_drawer_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="28dp"
                android:paddingBottom="28dp"
                android:text="@string/player_drawer_empty"
                android:textColor="@color/mobile_text_tertiary"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
