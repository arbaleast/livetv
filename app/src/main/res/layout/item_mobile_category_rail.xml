<?xml version="1.0" encoding="utf-8"?>
<!-- 左侧分类导航项：胶囊 + 右侧数量角标 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/category_rail_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="8dp"
    android:background="@drawable/bg_mobile_category_pill"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="40dp"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/rail_category_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/mobile_text_primary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/rail_category_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:textColor="@color/mobile_text_tertiary"
        android:textSize="10sp" />
</LinearLayout>
