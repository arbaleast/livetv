<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit" />

    <!--
        触控设备的点击/双击/亮度/音量手势捕获层：TV 设备保持 GONE，不参与任何焦点与按键逻辑。
    -->
    <View
        android:id="@+id/view_tap_catcher"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:contentDescription="@string/player_tap_catcher_desc"
        android:focusable="false"
        android:visibility="gone" />

    <TextView
        android:id="@+id/channel_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="24dp"
        android:background="@drawable/bg_player_badge"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:textColor="@android:color/white"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- 加载 / 缓冲 / 切台状态胶囊（含转圈指示器） -->
    <LinearLayout
        android:id="@+id/status_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_player_badge"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/status_progress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="10dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/error_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:accessibilityLiveRegion="polite"
        android:background="@drawable/bg_player_badge"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp"
        android:textColor="@android:color/white"
        android:textSize="17sp"
        android:visibility="gone" />

    <!--
        手机端共享外框（顶/底渐变栏、矢量图标、锁屏键、居中胶囊 HUD、统一错误卡片与分组筛选抽屉）：
        TV 端保持 GONE，完全不影响 Leanback / TV 遥控器交互。
    -->
    <include
        android:id="@+id/mobile_chrome"
        layout="@layout/view_mobile_player_chrome"
        android:visibility="gone" />

    <!-- TV 端频道列表抽屉：半透明遮罩 + 右侧滑出面板（手机端改由 mobile_chrome 统一接管） -->
    <View
        android:id="@+id/drawer_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/mobile_drawer_scrim"
        android:clickable="true"
        android:contentDescription="@string/player_drawer_scrim_desc"
        android:focusable="false"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/channel_drawer"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/bg_player_drawer"
        android:visibility="gone">

        <View
            android:id="@+id/drawer_left_edge"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="@color/mobile_drawer_edge" />

        <LinearLayout
            android:id="@+id/drawer_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/drawer_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="18dp"
                android:paddingTop="18dp"
                android:paddingEnd="18dp"
                android:paddingBottom="10dp"
                android:text="@string/player_drawer_title"
                android:textColor="@color/mobile_text_tertiary"
                android:textSize="12sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/drawer_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="18dp"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/drawer_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="28dp"
                android:paddingBottom="28dp"
                android:text="@string/player_drawer_empty"
                android:textColor="@color/mobile_text_tertiary"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
